<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-Backup ab Android 12: nur die Datenbank und die Einstellungen. Videos liegen in der Galerie. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="tanzlexikon.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tanzlexikon.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
